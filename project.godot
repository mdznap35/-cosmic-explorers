config_version=5

[application]
config/name="مستكشفو الكون"
config/description="رحلة فضائية تفاعلية باللغة العربية، مصممة للأطفال وتعمل دون اتصال."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="0.1.0"
config/icon="res://assets/branding/app_icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.012, 0.021, 0.058, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=9.8

[application/run]
low_processor_mode=false
