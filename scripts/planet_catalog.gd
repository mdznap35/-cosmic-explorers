static func get_planet(planet_id: String) -> Dictionary:
	for planet in PLANETS:
		if str(planet.get("id", "")) == planet_id:
			return planet.duplicate(true)
	return {}


static func get_all() -> Array:
	return PLANETS.duplicate(true)
